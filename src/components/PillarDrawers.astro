---
import { pillars } from '../data/pillars';
---

<section class="drawers" aria-label="四支柱分类举例">
  <div class="drawers-head">
    <p class="drawers-caption">四个抽屉 · 分类举例</p>
    <div class="pillar-btns">
      {pillars.map((p) => (
        <button
          class="pillar-btn"
          style={`--pc:${p.color}`}
          data-pillar={p.id}
          aria-expanded="false"
          aria-controls={`drawer-${p.id}`}
        >
          <span class="dot" aria-hidden="true"></span>
          {p.name}
          <span class="count">{p.stocks.length}</span>
        </button>
      ))}
    </div>
  </div>

  {pillars.map((p) => (
    <div class="drawer" id={`drawer-${p.id}`} style={`--pc:${p.color}`} hidden>
      <div class="drawer-head">
        <h3><span class="dot" aria-hidden="true"></span>{p.name}<span class="count">{p.stocks.length} 只</span></h3>
        <p class="blurb">{p.blurb}</p>
      </div>
      <div class="stock-grid">
        {p.stocks.map((s) => (
          <span class="stock" title={`${s.ticker} · ${s.name}`}><b>{s.ticker}</b><i>{s.name}</i></span>
        ))}
      </div>
      <p class="disclaimer">分类举例仅供教育与研究交流，不构成投资建议。</p>
    </div>
  ))}
</section>

<script>
  const btns = Array.from(document.querySelectorAll('.pillar-btn'));
  const drawers = Array.from(document.querySelectorAll('.drawer'));
  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = document.getElementById('drawer-' + btn.dataset.pillar);
      const willOpen = target.hidden;
      drawers.forEach((d) => { d.hidden = true; });
      btns.forEach((b) => { b.setAttribute('aria-expanded', 'false'); b.classList.remove('active'); });
      if (willOpen) {
        target.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('active');
      }
    });
  });
</script>

<style>
  .drawers { margin: 2rem 0 0.5rem; }
  .drawers-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.25rem;
  }
  .drawers-caption {
    margin: 0; font-size: 0.85rem; letter-spacing: 0.08em; color: var(--muted);
  }
  .pillar-btns { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end; }
  .pillar-btn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.45rem 0.9rem; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface); color: var(--fg);
    font: inherit; font-size: 0.9rem; cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .pillar-btn .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--pc); flex: none; }
  .pillar-btn .count {
    font-size: 0.75rem; color: var(--muted); background: var(--surface-2);
    border-radius: 999px; padding: 0.1rem 0.45rem; font-variant-numeric: tabular-nums;
  }
  .pillar-btn:hover { transform: translateY(-1px); border-color: var(--pc); }
  .pillar-btn.active { border-color: var(--pc); box-shadow: 0 0 0 1px var(--pc); }
  .drawer {
    border: 1px solid var(--line); border-left: 3px solid var(--pc);
    border-radius: 12px; background: var(--surface);
    padding: 1.25rem; margin-top: 0.75rem;
  }
  .drawer[hidden] { display: none; }
  .drawer-head h3 {
    margin: 0 0 0.35rem; font-size: 1.05rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .drawer-head .dot { width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--pc); flex: none; }
  .drawer-head .count { font-size: 0.78rem; font-weight: 400; color: var(--muted); }
  .blurb { color: var(--muted); font-size: 0.9rem; margin: 0 0 1rem; line-height: 1.6; }
  .stock-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.4rem; max-height: 320px; overflow-y: auto; padding-right: 0.25rem;
  }
  .stock {
    display: flex; align-items: baseline; gap: 0.5rem; min-width: 0;
    padding: 0.35rem 0.6rem; background: var(--surface-2); border-radius: 8px;
    font-size: 0.85rem;
  }
  .stock b { font-family: var(--mono, monospace); font-size: 0.8rem; flex: none; }
  .stock i {
    font-style: normal; color: var(--muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .disclaimer { margin: 1rem 0 0; font-size: 0.78rem; color: var(--muted); }
  @media (max-width: 640px) {
    .stock-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  }
</style>
